<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; font-src https://fonts.gstatic.com; script-src 'self' 'unsafe-inline';">
  <title>Paolo Maggioni | Senior Oracle PL/SQL Developer</title>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@300;400;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --navy: #0a1628;
      --blue: #1a3a6b;
      --accent: #c8a96e;
      --accent-light: #e8c98e;
      --text: #2c3e50;
      --text-light: #5a6a7a;
      --bg: #f7f8fa;
      --white: #ffffff;
      --border: #dde3ec;
      --code-bg: #eef2f7;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'IBM Plex Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
    }

    .toolbar {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 24px;
      background: rgba(10,22,40,0.97);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid rgba(200,169,110,0.3);
    }

    .toolbar-brand {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 13px;
      color: var(--accent);
      letter-spacing: 0.08em;
    }

    .toolbar-actions {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .btn-pdf {
      background: var(--accent);
      color: var(--navy);
      border: none;
      padding: 7px 16px;
      border-radius: 4px;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      letter-spacing: 0.05em;
      transition: background 0.2s;
    }
    .btn-pdf:hover { background: var(--accent-light); }

    .lang-btns button {
      background: transparent;
      border: 1px solid rgba(200,169,110,0.4);
      color: #aab;
      padding: 6px 14px;
      border-radius: 4px;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .lang-btns button.active,
    .lang-btns button:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .page-wrap {
      max-width: 960px;
      margin: 0 auto;
      background: var(--white);
      box-shadow: 0 0 40px rgba(0,0,0,0.08);
      min-height: 100vh;
      padding-top: 56px;
    }

    header {
      background: var(--navy);
      padding: 3.5rem 3rem 3rem;
      position: relative;
      overflow: hidden;
    }

    header::before {
      content: '';
      position: absolute;
      top: -40px; right: -40px;
      width: 300px; height: 300px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(200,169,110,0.08) 0%, transparent 70%);
    }

    header::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--accent) 0%, transparent 100%);
    }

    .header-tag {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      color: var(--accent);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 1rem;
    }

    header h1 {
      font-family: 'IBM Plex Sans', sans-serif;
      font-weight: 300;
      font-size: 2.8rem;
      color: var(--white);
      letter-spacing: 0.04em;
      margin-bottom: 0.4rem;
    }

    .header-role {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 1rem;
      color: var(--accent);
      margin-bottom: 1.6rem;
    }

    .header-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 1.2rem;
      font-size: 0.88rem;
      color: #8899bb;
    }

    .header-meta a {
      color: #8899bb;
      text-decoration: none;
    }
    .header-meta a:hover { color: var(--accent); }

    .content {
      padding: 2.5rem 3rem;
    }

    section {
      margin-bottom: 3rem;
    }

    .section-label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.5rem;
    }

    h2 {
      font-size: 1.5rem;
      font-weight: 600;
      color: var(--navy);
      margin-bottom: 1.5rem;
      padding-bottom: 0.6rem;
      border-bottom: 2px solid var(--navy);
    }

    .summary-box {
      background: var(--navy);
      color: #c8d8f0;
      padding: 2rem;
      border-radius: 6px;
      font-size: 0.97rem;
      line-height: 1.8;
      margin-bottom: 2rem;
      position: relative;
      overflow: hidden;
    }

    .summary-box::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 4px;
      background: var(--accent);
    }

    .summary-box strong { color: var(--accent-light); }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .skill-block {
      background: var(--code-bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 1.2rem 1.4rem;
    }

    .skill-block h4 {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.78rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.8rem;
    }

    .skill-block ul { list-style: none; padding: 0; }

    .skill-block li {
      font-size: 0.9rem;
      color: var(--text);
      padding: 0.2rem 0;
      padding-left: 1rem;
      position: relative;
    }

    .skill-block li::before {
      content: '›';
      position: absolute;
      left: 0;
      color: var(--accent);
      font-weight: bold;
    }

    /* ─── DBA DISTINCTION BOX ─── */
    .dba-box {
      background: var(--navy);
      border-radius: 6px;
      padding: 1.8rem 2rem;
      margin-top: 1.8rem;
      position: relative;
      overflow: hidden;
    }

    .dba-box::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 4px;
      background: var(--accent);
      border-radius: 4px 0 0 4px;
    }

    .dba-box-header {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.72rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 1.2rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .dba-box-header::after {
      content: '';
      flex: 1;
      height: 1px;
      background: rgba(200,169,110,0.25);
    }

    .dba-profiles {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-bottom: 1.2rem;
    }

    .dba-profile {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(200,169,110,0.15);
      border-radius: 5px;
      padding: 1rem 1.2rem;
    }

    .dba-profile.mine {
      border-color: rgba(200,169,110,0.45);
      background: rgba(200,169,110,0.07);
    }

    .dba-profile-label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--accent);
      margin-bottom: 0.4rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .dba-profile.mine .dba-profile-label { color: var(--accent-light); }

    .mine-badge {
      background: var(--accent);
      color: var(--navy);
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      padding: 1px 6px;
      border-radius: 2px;
    }

    .dba-profile p {
      font-size: 0.83rem;
      color: #8899bb;
      line-height: 1.6;
    }

    .dba-profile.mine p { color: #c8d8f0; }

    .dba-note {
      font-size: 0.84rem;
      color: #8899bb;
      border-top: 1px solid rgba(200,169,110,0.15);
      padding-top: 1rem;
      font-style: italic;
    }

    .dba-note strong {
      color: var(--accent-light);
      font-style: normal;
    }

    /* ─── EXPERIENCE ─── */
    .exp-item {
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 1.6rem;
      margin-bottom: 1.2rem;
      position: relative;
      transition: border-color 0.2s;
    }

    .exp-item:hover { border-color: var(--accent); }

    .exp-item::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 3px;
      background: var(--blue);
      border-radius: 3px 0 0 3px;
    }

    .exp-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 0.4rem;
    }

    .exp-company {
      font-weight: 600;
      font-size: 1.05rem;
      color: var(--navy);
    }

    .exp-date {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.8rem;
      color: var(--text-light);
    }

    .exp-role {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.85rem;
      color: var(--blue);
      margin-bottom: 0.8rem;
    }

    .exp-item p { font-size: 0.92rem; margin-bottom: 0.5rem; }
    .exp-item ul { padding-left: 1.2rem; font-size: 0.9rem; }
    .exp-item li { margin-bottom: 0.3rem; }

    .tech-tags {
      margin-top: 1rem;
      padding-top: 0.8rem;
      border-top: 1px solid var(--border);
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .tech-tag {
      background: var(--navy);
      color: var(--accent);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.72rem;
      padding: 3px 9px;
      border-radius: 3px;
      letter-spacing: 0.03em;
    }

    .avail-box {
      background: var(--navy);
      color: #c8d8f0;
      border-radius: 6px;
      padding: 1.8rem 2rem;
    }

    .avail-box h3 {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.85rem;
      color: var(--accent);
      letter-spacing: 0.1em;
      margin-bottom: 0.8rem;
    }

    .avail-box ul { list-style: none; padding: 0; }

    .avail-box li {
      padding: 0.3rem 0 0.3rem 1.2rem;
      position: relative;
      font-size: 0.92rem;
    }

    .avail-box li::before {
      content: '→';
      position: absolute;
      left: 0;
      color: var(--accent);
    }

    .ref-item {
      padding: 1.2rem 0;
      border-bottom: 1px solid var(--border);
    }

    .ref-item:last-child { border-bottom: none; }

    .ref-name {
      font-weight: 600;
      color: var(--navy);
      font-size: 0.95rem;
    }

    .ref-title {
      font-size: 0.82rem;
      color: var(--text-light);
      font-style: italic;
      margin-bottom: 0.5rem;
    }

    .ref-item blockquote {
      font-size: 0.88rem;
      color: var(--text);
      border-left: 3px solid var(--accent);
      padding-left: 1rem;
      line-height: 1.7;
    }

    .lang-content { display: none; }
    .lang-content.active { display: block; }

    @media print {
      .toolbar { display: none; }
      .page-wrap { padding-top: 0; box-shadow: none; }
      body { background: white; }
      * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
    }

    @media (max-width: 700px) {
      .content { padding: 1.5rem; }
      header { padding: 2rem 1.5rem; }
      header h1 { font-size: 2rem; }
      .skills-grid, .dba-profiles { grid-template-columns: 1fr; }
      .toolbar { padding: 10px 14px; }
      .toolbar-brand { display: none; }
    }
  </style>
</head>
